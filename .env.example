# ============================================
# TEVANOXMOVIE BACKEND - Environment Variables
# ============================================

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/tevanoxmovie
MONGO_DB_NAME=tevanoxmovie

# Security
SECRET_KEY=your_strong_secret_key_min_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Domain Configuration
DOMAIN=tevanox.com
API_URL=https://tevanoxmovie-backend.onrender.com
WEB_URL=https://tevanoxmovie-web.onrender.com
ADMIN_URL=https://tevanoxmovie-admin.onrender.com
MOBILE_URL=https://expo.dev/your-app
AGENT_URL=https://tevanoxmovie-agent.onrender.com

# Storage (MinIO/S3)
STORAGE_ENDPOINT=https://storage.tevanox.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET=tevanoxmovie

# Payment (Paystack)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxx

# Commission Rates
TEVANOX_SHARE=0.60
NETWORK_TOTAL=0.40
LEVEL_1_COMMISSION=0.25
LEVEL_2_COMMISSION=0.10
LEVEL_3_COMMISSION=0.05
